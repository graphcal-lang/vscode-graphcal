{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Graphcal",
  "scopeName": "source.graphcal",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#finite-position" },
    { "include": "#attribute" },
    { "include": "#type-declaration" },
    { "include": "#base-dimension-declaration" },
    { "include": "#dimension-declaration" },
    { "include": "#base-unit-declaration" },
    { "include": "#unit-declaration" },
    { "include": "#coordinate-index-declaration" },
    { "include": "#index-declaration" },
    { "include": "#param-declaration" },
    { "include": "#const-node-declaration" },
    { "include": "#const-unit-declaration" },
    { "include": "#node-declaration" },
    { "include": "#assert-declaration" },
    { "include": "#plot-declaration" },
    { "include": "#mark-keyword" },
    { "include": "#encode-keyword" },
    { "include": "#figure-declaration" },
    { "include": "#layer-declaration" },
    { "include": "#dag-declaration" },
    { "include": "#include-declaration" },
    { "include": "#plugin-import-declaration" },
    { "include": "#import-declaration" },
    { "include": "#for-binding" },
    { "include": "#table-index-list" },
    { "include": "#as-keyword" },
    { "include": "#control-keywords" },
    { "include": "#generic-params" },
    { "include": "#return-type" },
    { "include": "#conversion-target" },
    { "include": "#type-annotation" },
    { "include": "#match-index-label-pattern" },
    { "include": "#match-constructor-pattern" },
    { "include": "#recurrence-keyword" },
    { "include": "#key-former-keyword" },
    { "include": "#generic-call-application" },
    { "include": "#fn-call" },
    { "include": "#inline-dag-output-projection" },
    { "include": "#graph-ref" },
    { "include": "#qualified-const-ref" },
    { "include": "#qualified-variant" },
    { "include": "#booleans" },
    { "include": "#wildcard" },
    { "include": "#quantity-literal" },
    { "include": "#numbers" },
    { "include": "#builtin-types" },
    { "include": "#upper-constant" },
    { "include": "#pascal-type" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.graphcal",
      "match": "//.*$"
    },

    "strings": {
      "name": "string.quoted.double.graphcal",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.graphcal" }
      }
    },

    "type-declaration": {
      "comment": "A required type ends with ';'; a body contains bare or parenthesized constructors. Constructor payload braces are not a supported alias.",
      "begin": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(type)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "end": "(;)|(\\})",
      "beginCaptures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.type.graphcal" },
        "3": { "name": "entity.name.type.graphcal" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.terminator.graphcal" },
        "2": { "name": "punctuation.brackets.curly.graphcal" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#generic-params" },
        { "include": "#constructor-declaration" },
        { "include": "#type-annotation" },
        { "include": "#builtin-types" },
        { "include": "#pascal-type" },
        { "include": "#punctuation" }
      ]
    },

    "constructor-declaration": {
      "comment": "Constructor declaration inside a type body: Ctor(...), Unit,",
      "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\b(?=\\s*(?:\\(|,|\\}))",
      "captures": {
        "1": { "name": "entity.name.type.constructor.graphcal" }
      }
    },

    "base-dimension-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(base)\\s+(dim)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.dimension.graphcal" },
        "3": { "name": "keyword.declaration.dimension.graphcal" },
        "4": { "name": "entity.name.type.graphcal" }
      }
    },

    "dimension-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(dim)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.dimension.graphcal" },
        "3": { "name": "entity.name.type.graphcal" }
      }
    },

    "base-unit-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(base)\\s+(unit)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.unit.graphcal" },
        "3": { "name": "keyword.declaration.unit.graphcal" },
        "4": { "name": "entity.name.type.graphcal" }
      }
    },

    "unit-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(unit)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.unit.graphcal" },
        "3": { "name": "entity.name.type.graphcal" }
      }
    },

    "coordinate-index-declaration": {
      "comment": "Exact-step range and exact-count linspace declarations.",
      "begin": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(index)\\s+([a-zA-Z][a-zA-Z0-9_]*)\\s*=\\s*(range|linspace)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.index.graphcal" },
        "3": { "name": "entity.name.type.graphcal" },
        "4": { "name": "keyword.other.coordinate-constructor.graphcal" },
        "5": { "name": "punctuation.brackets.round.graphcal" }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": { "name": "punctuation.brackets.round.graphcal" }
      },
      "patterns": [
        {
          "match": "\\b(step|points)\\b(?=\\s*:)",
          "name": "keyword.other.coordinate-spacing.graphcal"
        },
        { "include": "#coordinate-index-parentheses" },
        { "include": "$self" }
      ]
    },

    "coordinate-index-parentheses": {
      "begin": "(\\()",
      "beginCaptures": {
        "1": { "name": "punctuation.brackets.round.graphcal" }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": { "name": "punctuation.brackets.round.graphcal" }
      },
      "patterns": [
        { "include": "#coordinate-index-parentheses" },
        { "include": "$self" }
      ]
    },

    "index-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(index)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.index.graphcal" },
        "3": { "name": "entity.name.type.graphcal" }
      }
    },

    "param-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(param)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.param.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "node-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(node)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.node.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "const-node-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(const)\\s+(node)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.const.graphcal" },
        "3": { "name": "keyword.declaration.node.graphcal" },
        "4": { "name": "variable.other.constant.graphcal" }
      }
    },

    "const-unit-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(const)\\s+(unit)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.const.graphcal" },
        "3": { "name": "keyword.declaration.unit.graphcal" },
        "4": { "name": "entity.name.type.unit.graphcal" }
      }
    },

    "finite-position": {
      "comment": "Positional #N key for a structural Fin axis.",
      "match": "(#)([0-9][0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.finite-position.graphcal" },
        "2": { "name": "constant.numeric.graphcal" }
      }
    },

    "attribute": {
      "comment": "Attribute: #[name] or #[name(arg1, Index#Variant, #2, (A#X, #1))]",
      "begin": "(#)(\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.graphcal" },
        "2": { "name": "punctuation.definition.attribute.graphcal" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.attribute.graphcal" }
      },
      "patterns": [
        { "include": "#finite-position" },
        {
          "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\b",
          "name": "entity.other.attribute-name.graphcal"
        },
        {
          "match": "::|#|\\.",
          "name": "punctuation.accessor.graphcal"
        },
        {
          "match": "[(),]",
          "name": "punctuation.separator.graphcal"
        }
      ]
    },

    "assert-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(assert)\\s+([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.assert.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "plot-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(plot)\\s+([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.plot.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "mark-keyword": {
      "match": "\\b(mark)\\s*:\\s*(point|line|bar|area|rect|tick)\\b",
      "captures": {
        "1": { "name": "keyword.other.mark.graphcal" },
        "2": { "name": "support.type.mark.graphcal" }
      }
    },

    "encode-keyword": {
      "match": "\\b(encode)\\s*:",
      "captures": {
        "1": { "name": "keyword.other.encode.graphcal" }
      }
    },

    "figure-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(figure)\\s+([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.figure.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "layer-declaration": {
      "match": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(layer)\\s+([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.layer.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "plugin-import-declaration": {
      "comment": "Plugin import with extern function declarations (graphcal#943, binder constraints per graphcal#25 Phase D): import plugin \"path\" as alias { fn name<D1: Dim, D2: Dim>(p: Type, ...) -> Type; ... }. `plugin` is a contextual keyword — this rule engages only when `import plugin` is followed by a string literal, so `import plugin.tools as t;` stays an ordinary module import. The block ends at `}` with no trailing `;`. Must precede #import-declaration in the top-level pattern list.",
      "begin": "\\b(import)\\s+(plugin)\\b(?=\\s*\")",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.import.graphcal" },
        "2": { "name": "keyword.other.plugin.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.brackets.curly.graphcal" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "comment": "Plugin alias: import plugin \"…\" as fluids",
          "match": "\\b(as)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.as.graphcal" },
            "2": { "name": "entity.name.namespace.graphcal" }
          }
        },
        { "include": "#extern-fn-declaration" },
        {
          "match": "\\{",
          "name": "punctuation.brackets.curly.graphcal"
        }
      ]
    },

    "extern-fn-declaration": {
      "comment": "Extern function declaration inside an import plugin block: fn density(p: Pressure, t: Temperature) -> Density; fn smooth<D: Dim, I: Index>(xs: D[I], window: Dimensionless) -> D[I]; fn geometric_mean<D1: Dim, D2: Dim>(x: D1, y: D2) -> D1^(1/2) * D2^(1/2);. Generic binders use the same name-colon-constraint form as type-declaration generics (restricted to Dim and Index), so they reuse #generic-params.",
      "begin": "\\b(fn)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
      "end": ";",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.function.graphcal" },
        "2": { "name": "entity.name.function.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.terminator.graphcal" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#generic-params" },
        { "include": "#return-type" },
        {
          "comment": "Parameter name before its type annotation: (p: Pressure, ...)",
          "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\b(?=\\s*:)",
          "name": "variable.parameter.graphcal"
        },
        { "include": "#type-annotation" },
        {
          "match": "[()]",
          "name": "punctuation.brackets.round.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        }
      ]
    },

    "import-declaration": {
      "comment": "Whole-DAG imports may be public; selective imports use `::{ ... }` and per-item visibility.",
      "begin": "(?:\\b(pub)\\s+)?\\b(import)\\b",
      "end": ";",
      "beginCaptures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.import.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.terminator.graphcal" }
      },
      "patterns": [
        { "include": "#module-path" },
        {
          "comment": "Module alias: import nasa.rocket as alias",
          "match": "\\b(as)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.as.graphcal" },
            "2": { "name": "entity.name.namespace.graphcal" }
          }
        },
        { "include": "#import-item-list" }
      ]
    },

    "dag-declaration": {
      "begin": "(?:\\b(pub(?:\\s*\\(\\s*bind\\s*\\))?)\\s+)?\\b(dag)\\s+([a-z][a-z0-9_]*)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.pub.graphcal" },
        "2": { "name": "keyword.declaration.dag.graphcal" },
        "3": { "name": "entity.name.function.dag.graphcal" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },

    "include-declaration": {
      "comment": "Include use-sites have no leading visibility: include nasa.rocket(args); / include nasa.rocket(args) as r; / include nasa.rocket(args)::{pub out};",
      "begin": "\\b(include)\\b",
      "end": ";",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.include.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.terminator.graphcal" }
      },
      "patterns": [
        { "include": "#module-path" },
        {
          "comment": "Module alias: include nasa.rocket(args) as alias",
          "match": "\\b(as)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.as.graphcal" },
            "2": { "name": "entity.name.namespace.graphcal" }
          }
        },
        { "include": "#import-param-bindings" },
        { "include": "#import-item-list" }
      ]
    },

    "import-param-bindings": {
      "comment": "DAG input bindings: unmarked params or `type`/`dim`/`index` Static inputs.",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.brackets.round.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.brackets.round.graphcal" }
      },
      "patterns": [
        {
          "comment": "Input binding: [type|dim|index] name: expr",
          "match": "(?:\\b(type|dim|index)\\s+)?\\b([a-zA-Z][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "keyword.declaration.input-category.graphcal" },
            "2": { "name": "variable.other.graphcal" },
            "3": { "name": "punctuation.separator.colon.graphcal" }
          }
        },
        { "include": "#graph-ref" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#strings" },
            { "include": "#fn-call" },
        { "include": "#qualified-const-ref" },
        { "include": "#upper-constant" },
        { "include": "#pascal-type" },
        { "include": "#operators" },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        }
      ]
    },

    "import-item-list": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.brackets.curly.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.brackets.curly.graphcal" }
      },
      "patterns": [
        {
          "comment": "Selective re-export marker: { pub item, item } — only `pub` items are re-exported",
          "match": "\\b(pub)\\b(?!\\s*\\()",
          "name": "keyword.other.pub.graphcal"
        },
        {
          "comment": "Explicit non-term import category markers",
          "match": "\\b(type|dim|unit|index)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.import-category.graphcal" }
          }
        },
        {
          "match": "\\b(as)\\b",
          "name": "keyword.operator.as.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        },
        {
          "comment": "ALL_CAPS identifiers are constants",
          "match": "\\b([A-Z][A-Z0-9_]*[A-Z0-9])\\b|\\b([A-Z]{2,})\\b",
          "name": "variable.other.constant.graphcal"
        },
        {
          "comment": "PascalCase identifiers are types/dimensions/indexes",
          "match": "\\b([A-Z][a-z][a-zA-Z0-9_]*)\\b",
          "name": "entity.name.type.graphcal"
        },
        {
          "comment": "snake_case identifiers are variables (params, nodes, fns)",
          "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.graphcal"
        }
      ]
    },

    "module-path": {
      "comment": "Dot-separated module path: nasa, nasa.rocket, nasa.orbital.transfer. Each segment is highlighted as a namespace.",
      "match": "\\b([a-z][a-z0-9_]*)(?:\\s*(\\.)\\s*([a-z][a-z0-9_]*))*\\b",
      "captures": {
        "1": { "name": "entity.name.namespace.graphcal" },
        "2": { "name": "punctuation.accessor.dot.graphcal" },
        "3": { "name": "entity.name.namespace.graphcal" }
      }
    },

    "as-keyword": {
      "match": "\\b(as)\\b",
      "name": "keyword.operator.as.graphcal"
    },

    "for-binding": {
      "comment": "for m: Maneuver, i: Fin(3), j: Fin(N + 1) — highlight all bindings",
      "begin": "\\b(for)\\b",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.graphcal" }
      },
      "patterns": [
        {
          "comment": "Structural finite binding: var: Fin(N + 1)",
          "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\s*(:)\\s*(Fin)\\s*(\\()([^()]*)?(\\))",
          "captures": {
            "1": { "name": "variable.other.graphcal" },
            "2": { "name": "punctuation.separator.colon.graphcal" },
            "3": { "name": "keyword.other.finite-index.graphcal" },
            "4": { "name": "punctuation.brackets.round.graphcal" },
            "5": { "name": "meta.type-level.nat.graphcal" },
            "6": { "name": "punctuation.brackets.round.graphcal" }
          }
        },
        {
          "comment": "Named index binding: var: IndexName or var: module::IndexName",
          "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\s*(:)\\s*((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.graphcal" },
            "2": { "name": "punctuation.separator.colon.graphcal" },
            "3": { "name": "entity.name.type.graphcal" }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        },
        {
          "match": "=>",
          "name": "keyword.operator.fat-arrow.graphcal"
        }
      ]
    },

    "table-index-list": {
      "comment": "Typed axes in table[Named, module::Axis, Fin(3)].",
      "begin": "\\b(table)\\s*(\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "1": { "name": "keyword.control.graphcal" },
        "2": { "name": "punctuation.brackets.square.graphcal" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.brackets.square.graphcal" }
      },
      "patterns": [
        {
          "match": "\\b(Fin)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.finite-index.graphcal" }
          }
        },
        { "include": "#numbers" },
        {
          "match": "\\b(?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.graphcal"
        },
        {
          "match": "[-+*]",
          "name": "keyword.operator.arithmetic.graphcal"
        },
        {
          "match": "[(),]",
          "name": "punctuation.separator.graphcal"
        }
      ]
    },

    "control-keywords": {
      "match": "\\b(if|else|for|match|table)\\b",
      "name": "keyword.control.graphcal"
    },

    "recurrence-keyword": {
      "comment": "Bare scan( and unfold( commit to recurrence syntax; qualified calls and other uses are identifiers.",
      "match": "(?<![.:])\\b(scan|unfold)\\b(?=\\s*\\()",
      "name": "support.function.builtin.graphcal"
    },

    "key-former-keyword": {
      "comment": "Bare key(, fin_key(, floor_key(, ceil_key(, and nearest_key( commit to key-former syntax; qualified calls and other uses are identifiers.",
      "match": "(?<![.:])\\b(key|fin_key|floor_key|ceil_key|nearest_key)\\b(?=\\s*\\()",
      "name": "support.function.builtin.graphcal"
    },

    "generic-params": {
      "comment": "Sort-aware generic parameters and defaults: <D: Dim, I: Index, N: Nat = 3, F: Type = Marker>",
      "begin": "<(?=[A-Z]\\w*\\s*:)",
      "end": ">",
      "beginCaptures": {
        "0": { "name": "punctuation.brackets.angle.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.brackets.angle.graphcal" }
      },
      "patterns": [
        { "include": "#generic-arguments" },
        { "include": "#builtin-types" },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "entity.name.type.graphcal" },
            "2": { "name": "punctuation.separator.colon.graphcal" }
          }
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.graphcal"
        },
        {
          "match": "[-+*/^]",
          "name": "keyword.operator.arithmetic.graphcal"
        },
        { "include": "#numbers" },
        {
          "match": "\\b[A-Za-z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        }
      ]
    },

    "generic-call-application": {
      "comment": "A constructor or parsed function call with sort-aware generic arguments, such as Fixed<3>(...) or module::Matrix<M * N + 1>(...). Functions currently reject non-empty generic lists semantically.",
      "begin": "\\b((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)\\s*(<)(?=[^\\n]*>\\s*\\()",
      "end": "(>)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.graphcal" },
        "2": { "name": "punctuation.brackets.angle.graphcal" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.brackets.angle.graphcal" }
      },
      "patterns": [
        { "include": "#generic-argument-contents" }
      ]
    },

    "generic-arguments": {
      "comment": "Generic arguments shared by type and constructor applications; semantic resolution sorts each as Dim, Index, Nat, or Type.",
      "begin": "(<)",
      "end": "(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.brackets.angle.graphcal" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.brackets.angle.graphcal" }
      },
      "patterns": [
        { "include": "#generic-argument-contents" }
      ]
    },

    "generic-argument-contents": {
      "patterns": [
        { "include": "#generic-arguments" },
        {
          "match": "\\b(Fin)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.finite-index.graphcal" }
          }
        },
        { "include": "#builtin-types" },
        { "include": "#type-constraints" },
        { "include": "#numbers" },
        {
          "match": "\\b[A-Za-z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.graphcal"
        },
        {
          "match": "[-+*/^]",
          "name": "keyword.operator.arithmetic.graphcal"
        },
        {
          "match": "[\\[\\]()]",
          "name": "punctuation.brackets.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        },
        {
          "match": "::|\\.",
          "name": "punctuation.accessor.graphcal"
        }
      ]
    },

    "return-type": {
      "comment": "Return type after ') ->': -> D, -> Velocity, -> D^-1, -> D1^(1/2) * D2^(1/2). Dimension monomials over dim variables use rational exponents and cross-variable products (graphcal#943).",
      "begin": "(?<=\\))\\s*(->)\\s*(?=[A-Za-z])",
      "end": "(?=[=;{])",
      "beginCaptures": {
        "1": { "name": "keyword.operator.arrow.graphcal" }
      },
      "patterns": [
        { "include": "#builtin-types" },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
          "name": "entity.name.type.graphcal"
        },
        {
          "comment": "Integer or rational exponent value: 2, -1, 1/2, -1/2",
          "match": "-?[0-9]+(?:\\s*/\\s*[0-9]+)?",
          "name": "constant.numeric.graphcal"
        },
        {
          "match": "[*/^]",
          "name": "keyword.operator.arithmetic.graphcal"
        },
        {
          "match": "[()]",
          "name": "punctuation.brackets.round.graphcal"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.brackets.square.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        }
      ]
    },

    "conversion-target": {
      "comment": "Conversion target after '->' in expressions: @a -> km, @a -> u::mile, @a -> m/s^2, @x -> 1/min, @p -> (kg * m/s).",
      "match": "(->)\\s*((?:(?:1\\s*/\\s*)?[a-zA-Z][a-zA-Z0-9_]*(?:(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*[a-zA-Z][a-zA-Z0-9_]*)?(?:\\^-?[0-9]+(?:/[0-9]+)?)?(?:\\s*[*/]\\s*[a-zA-Z][a-zA-Z0-9_]*(?:(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*[a-zA-Z][a-zA-Z0-9_]*)?(?:\\^-?[0-9]+(?:/[0-9]+)?)?)*|\\([^\\r\\n()]+\\)(?:\\^-?[0-9]+(?:/[0-9]+)?)?))",
      "captures": {
        "1": { "name": "keyword.operator.arrow.graphcal" },
        "2": { "patterns": [{ "include": "#unit-expression-segments" }] }
      }
    },

    "quantity-literal": {
      "comment": "Quantity literal: a number and same-line unit expression — 2.0 km, 9.81 m/s^2, 2.0 1/s, 3.0 (kg * m/s), 2.0 u::mile.",
      "match": "\\b([0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?)[ \\t]+(?!(?:if|else|match|for|in|as|true|false)\\b)((?:(?:1[ \\t]*/[ \\t]*)?[a-zA-Z][a-zA-Z0-9_]*(?:(?:[ \\t]*\\.[ \\t]*[a-zA-Z][a-zA-Z0-9_]*)*[ \\t]*::[ \\t]*[a-zA-Z][a-zA-Z0-9_]*)?(?:\\^-?[0-9]+(?:/[0-9]+)?)?(?:[ \\t]*[*/][ \\t]*[a-zA-Z][a-zA-Z0-9_]*(?:(?:[ \\t]*\\.[ \\t]*[a-zA-Z][a-zA-Z0-9_]*)*[ \\t]*::[ \\t]*[a-zA-Z][a-zA-Z0-9_]*)?(?:\\^-?[0-9]+(?:/[0-9]+)?)?)*|\\([^\\r\\n()]+\\)(?:\\^-?[0-9]+(?:/[0-9]+)?)?))",
      "captures": {
        "1": { "name": "constant.numeric.graphcal" },
        "2": { "patterns": [{ "include": "#unit-expression-segments" }] }
      }
    },

    "unit-expression-segments": {
      "comment": "Segments inside a unit expression. `alias.child::unit` preserves the namespace/member boundary.",
      "patterns": [
        {
          "match": "([a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*)(\\s*::\\s*)([a-zA-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.graphcal" },
            "2": { "name": "punctuation.accessor.graphcal" },
            "3": { "name": "entity.name.type.unit.graphcal" }
          }
        },
        { "match": "[a-zA-Z][a-zA-Z0-9_]*", "name": "entity.name.type.unit.graphcal" },
        { "match": "-?[0-9]+(?:/[0-9]+)?", "name": "constant.numeric.graphcal" },
        { "match": "[*/^]", "name": "keyword.operator.arithmetic.graphcal" },
        { "match": "[()]", "name": "punctuation.brackets.round.graphcal" }
      ]
    },

    "match-index-label-pattern": {
      "comment": "Owner-qualified fieldless index-label patterns: Maneuver#Departure or module::Maneuver#Departure.",
      "match": "\\b((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*\\s*#\\s*[A-Z][a-zA-Z0-9_]*)\\s*(?==>)",
      "captures": {
        "1": { "name": "entity.name.type.index.graphcal" }
      }
    },

    "match-constructor-pattern": {
      "comment": "Type-constructor patterns: Impulsive(...) => ..., module::Pick(...) => ..., or Coast => ...",
      "match": "\\b((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)\\s*(?=(?:\\([^)]*\\)\\s*)?=>)",
      "captures": {
        "1": { "name": "entity.name.type.constructor.graphcal" }
      }
    },

    "fn-call": {
      "comment": "Non-generic calls: sqrt(...), TransferResult(...), module::Pick(...), etc.",
      "match": "\\b((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)\\s*(?=(<[^>]*>)?\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.graphcal" }
      }
    },

    "type-annotation": {
      "comment": "Type annotation after ':' — matches ': Type', ': module::Type[Index, ...]', ': Type(min: expr, max: expr)'",
      "begin": "(?<=\\w)\\s*(:)\\s*(?=[A-Za-z])",
      "end": "(?=[=;,){])",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.colon.graphcal" }
      },
      "patterns": [
        { "include": "#generic-arguments" },
        {
          "match": "\\b(Fin)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.other.finite-index.graphcal" }
          }
        },
        { "include": "#builtin-types" },
        { "include": "#type-constraints" },
        {
          "match": "\\b((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)\\b",
          "name": "entity.name.type.graphcal"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.brackets.square.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        },
        {
          "match": "[-+*/^]",
          "name": "keyword.operator.arithmetic.graphcal"
        },
        { "include": "#numbers" }
      ]
    },

    "type-constraints": {
      "comment": "Domain constraints on type: (min: expr, max: expr)",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.brackets.round.graphcal" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.brackets.round.graphcal" }
      },
      "patterns": [
        {
          "comment": "Constraint key: min or max",
          "match": "\\b(min|max)\\s*(:)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.graphcal" },
            "2": { "name": "punctuation.separator.colon.graphcal" }
          }
        },
        { "include": "#numbers" },
        { "include": "#builtin-types" },
        { "include": "#pascal-type" },
        { "include": "#operators" },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        }
      ]
    },

    "graph-ref": {
      "comment": "Graph reference: @name or @instance::member. Dotted paths before a call remain DAG traversal.",
      "match": "(@)((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.variable.graphcal" },
        "2": { "name": "variable.other.graphcal" }
      }
    },

    "inline-dag-output-projection": {
      "comment": "Output projection following an inline DAG invocation: `)::output`",
      "match": "(\\))(::)([a-zA-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.brackets.round.graphcal" },
        "2": { "name": "punctuation.accessor.graphcal" },
        "3": { "name": "variable.other.graphcal" }
      }
    },

    "qualified-const-ref": {
      "comment": "Qualified built-in/user constant reference: module::CONST_NAME or module.path::CONST_NAME",
      "match": "\\b([a-z][a-z0-9_]*(?:\\s*\\.\\s*[a-z][a-z0-9_]*)*)(\\s*::\\s*)([A-Z][A-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "entity.name.namespace.graphcal" },
        "2": { "name": "punctuation.accessor.graphcal" },
        "3": { "name": "variable.other.constant.graphcal" }
      }
    },

    "qualified-variant": {
      "comment": "Owner-qualified label used by maps and slices: Maneuver#Departure or module::Maneuver#Departure. Ordinary table rows/columns stay bare.",
      "match": "\\b((?:[a-zA-Z][a-zA-Z0-9_]*(?:\\s*\\.\\s*[a-zA-Z][a-zA-Z0-9_]*)*\\s*::\\s*)?[a-zA-Z][a-zA-Z0-9_]*)(\\s*#\\s*)([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "entity.name.type.graphcal" },
        "2": { "name": "punctuation.definition.index-label.graphcal" },
        "3": { "name": "variable.other.enummember.graphcal" }
      }
    },

    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.graphcal"
    },

    "wildcard": {
      "match": "(?<![a-zA-Z0-9])_(?![a-zA-Z0-9_])",
      "name": "variable.language.wildcard.graphcal"
    },

    "numbers": {
      "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b",
      "name": "constant.numeric.graphcal"
    },

    "builtin-types": {
      "match": "\\b(Dimensionless|Bool|Int|Datetime|Complex|Key|Dim|Index|Nat|Type)\\b",
      "name": "support.type.graphcal"
    },

    "upper-constant": {
      "comment": "ALL_CAPS identifiers are built-in constants only (PI, E, TAU, SQRT2, etc.)",
      "match": "\\b([A-Z][A-Z0-9_]*[A-Z0-9])\\b|\\b([A-Z]{2,})\\b",
      "name": "variable.other.constant.graphcal"
    },

    "pascal-type": {
      "comment": "PascalCase identifiers are types/dimensions (Velocity, Length, Time, Mass, etc.)",
      "match": "\\b([A-Z][a-z][a-zA-Z0-9_]*)\\b",
      "name": "entity.name.type.graphcal"
    },

    "operators": {
      "patterns": [
        {
          "match": "=>",
          "name": "keyword.operator.fat-arrow.graphcal"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.graphcal"
        },
        {
          "match": "~=",
          "name": "keyword.operator.tolerance.graphcal"
        },
        {
          "match": "\\+/-",
          "name": "keyword.operator.plus-minus.graphcal"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.graphcal"
        },
        {
          "match": "&&|\\|\\|",
          "name": "keyword.operator.logical.graphcal"
        },
        {
          "match": "[+\\-*/^%]",
          "name": "keyword.operator.arithmetic.graphcal"
        },
        {
          "match": "!",
          "name": "keyword.operator.logical.not.graphcal"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.graphcal"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "match": "[()]",
          "name": "punctuation.brackets.round.graphcal"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.brackets.square.graphcal"
        },
        {
          "match": "[{}]",
          "name": "punctuation.brackets.curly.graphcal"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.graphcal"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.graphcal"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.graphcal"
        },
        {
          "match": "::|#|\\.",
          "name": "punctuation.accessor.graphcal"
        },
        {
          "match": "\\|",
          "name": "punctuation.separator.pipe.graphcal"
        }
      ]
    }
  }
}
