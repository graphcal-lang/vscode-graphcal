{
  "name": "graphcal",
  "displayName": "Graphcal",
  "version": "0.1.5",
  "description": "Graphcal language support: syntax highlighting and Language Server Protocol (LSP) integration",
  "categories": [
    "Programming Languages"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/graphcal-lang/vscode-graphcal"
  },
  "publisher": "Graphcal",
  "main": "./out/extension.js",
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "compile": "npm run check-types && npm run build -- --sourcemap",
    "watch": "npm run build -- --sourcemap --watch",
    "vscode:prepublish": "npm run check-types && npm run build -- --minify",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.0",
    "typescript": "6.0.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "graphcal",
        "aliases": [
          "Graphcal",
          "graphcal"
        ],
        "extensions": [
          ".gcl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "graphcal",
        "scopeName": "source.graphcal",
        "path": "./syntaxes/graphcal.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Graphcal",
      "properties": {
        "graphcal.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Graphcal Language Server for diagnostics, document symbols, go to definition, and hover."
        },
        "graphcal.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the graphcal executable. If empty, the extension will look for 'graphcal' on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "graphcal.restartServer",
        "title": "Graphcal: Restart Language Server"
      },
      {
        "command": "graphcal.jumpToNextTableCell",
        "title": "Graphcal: Jump to Next Table Cell"
      },
      {
        "command": "graphcal.jumpToPreviousTableCell",
        "title": "Graphcal: Jump to Previous Table Cell"
      }
    ],
    "keybindings": [
      {
        "command": "graphcal.jumpToNextTableCell",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'graphcal' && graphcal.cursorInTable && !suggestWidgetVisible && !inlineSuggestionVisible && !editorTabMovesFocus && !inSnippetMode"
      },
      {
        "command": "graphcal.jumpToPreviousTableCell",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'graphcal' && graphcal.cursorInTable && !suggestWidgetVisible && !inlineSuggestionVisible && !editorTabMovesFocus && !inSnippetMode"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:graphcal"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "packageManager": "npm@11.17.0"
}
