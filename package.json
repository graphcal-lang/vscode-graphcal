{
  "name": "graphcal",
  "displayName": "Graphcal",
  "version": "0.5.0",
  "description": "Graphcal language support: syntax highlighting and Language Server Protocol (LSP) integration",
  "categories": [
    "Programming Languages"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/graphcal-lang/vscode-graphcal"
  },
  "publisher": "Graphcal",
  "main": "./out/extension.js",
  "scripts": {
    "check": "vp check",
    "build": "vp pack",
    "compile": "vp check && vp pack --sourcemap",
    "watch": "vp pack --sourcemap --watch",
    "vscode:prepublish": "vp check && vp pack --minify",
    "package": "vsce package --no-dependencies",
    "test": "vp test"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.137.0",
    "@vscode/vsce": "3.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "contributes": {
    "languages": [
      {
        "id": "graphcal",
        "aliases": [
          "Graphcal",
          "graphcal"
        ],
        "extensions": [
          ".gcl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "graphcal",
        "scopeName": "source.graphcal",
        "path": "./syntaxes/graphcal.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Graphcal",
      "properties": {
        "graphcal.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Graphcal Language Server for diagnostics, document symbols, go to definition, and hover."
        },
        "graphcal.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the graphcal executable. If empty, the extension will look for 'graphcal' on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "graphcal.restartServer",
        "title": "Graphcal: Restart Language Server"
      },
      {
        "command": "graphcal.jumpToNextTableCell",
        "title": "Graphcal: Jump to Next Table Cell"
      },
      {
        "command": "graphcal.jumpToPreviousTableCell",
        "title": "Graphcal: Jump to Previous Table Cell"
      }
    ],
    "keybindings": [
      {
        "command": "graphcal.jumpToNextTableCell",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'graphcal' && graphcal.cursorInTable && !suggestWidgetVisible && !inlineSuggestionVisible && !editorTabMovesFocus && !inSnippetMode"
      },
      {
        "command": "graphcal.jumpToPreviousTableCell",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == 'graphcal' && graphcal.cursorInTable && !suggestWidgetVisible && !inlineSuggestionVisible && !editorTabMovesFocus && !inSnippetMode"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:graphcal"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "packageManager": "pnpm@12.4.2"
}
