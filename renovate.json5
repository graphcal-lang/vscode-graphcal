{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>graphcal-lang/renovate-config"],
  packageRules: [
    {
      description: "Update VS Code engine and @types/vscode together",
      matchManagers: ["npm"],
      matchDepNames: ["vscode", "@types/vscode"],
      groupName: "VS Code API",
      groupSlug: "vscode-api",
      rangeStrategy: "bump",
      minimumGroupSize: 2,
    },
  ],
}
